# Copy to .env and fill in.
#
# Only VLLM_HOST_MODELS_DIR is strictly required.
# Everything else has a sensible default.

# Absolute host path to your HuggingFace model cache directory.
# Must contain hub/ subdirectory with Qwen/Qwen3.6-27B snapshot already
# fetched (e.g. via `hf download Qwen/Qwen3.6-27B --cache-dir $VLLM_HOST_MODELS_DIR/hub`).
VLLM_HOST_MODELS_DIR=/absolute/path/to/hf-cache

# HuggingFace token. Required to download Qwen/Qwen3.6-27B because the
# model card is gated — you must first visit
#   https://huggingface.co/Qwen/Qwen3.6-27B
# while logged in and click "Agree and access repository" once. Then
# mint a read token at https://huggingface.co/settings/tokens and paste
# it here. Only used by `hf download` at cache-fill time; not needed at
# runtime (HF_HUB_OFFLINE=1 inside the container).
HF_TOKEN=hf_your_token_here

# Host-side directories for persistent JIT caches (survive container
# restarts so subsequent boots skip the ~3 min kernel compile).
# Defaults to repo-local .triton-cache/ and .vllm-cache/ if unset.
#VLLM_HOST_TRITON_CACHE=/absolute/path/to/triton-cache
#VLLM_HOST_VLLM_CACHE=/absolute/path/to/vllm-cache

# Loopback-only host port. Change if 8000 is taken.
VLLM_HOST_PORT=8000

# Model ID or local path. Override if serving a different Qwen3.x variant.
VLLM_MODEL_ID=Qwen/Qwen3.6-27B
VLLM_SERVED_MODEL_NAME=Qwen3.6-27B

# Concurrent serving slots. 1 for single-user home inference; raise if
# you want multi-tenant (costs more VRAM per extra slot).
VLLM_MAX_NUM_SEQS=1

# Max context window. Native max for Qwen 3.6 27B is 262144 (256K).
# Reducing this does NOT save compute — it only caps the longest prompt
# you can send. Leave at native unless you know why.
VLLM_MAX_MODEL_LEN=262144
